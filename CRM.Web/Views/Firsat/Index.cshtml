@model List<CRM.DTO.FirsatDto>

@{
    ViewData["Title"] = "Fırsatlar";
}

<h2>Fırsat Listesi</h2>
<input type="text" id="aramaKutusuFirsat" class="form-control mb-3" placeholder="Başlık veya durum ile ara..." onkeyup="tabloyuFiltreleFirsat()" style="max-width: 400px;" />

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Fırsat</a>
<table class="table table-striped" id="firsatTablosu">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Tahmini Tutar</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var firsat in Model)
        {
            <tr>
                <td>@firsat.FirsatBasligi</td>
                <td>@firsat.TahminiTutar</td>
                <td>@firsat.FirsatDurumu</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@firsat.FirsatId" class="btn btn-sm btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function tabloyuFiltreleFirsat() {
        var arananMetin = document.getElementById("aramaKutusuFirsat").value.toLowerCase();
        var tablo = document.getElementById("firsatTablosu");
        var satirlar = tablo.getElementsByTagName("tr");

        for (var i = 1; i < satirlar.length; i++) {
            var satir = satirlar[i];
            var satirMetni = satir.textContent.toLowerCase();
            satir.style.display = satirMetni.indexOf(arananMetin) > -1 ? "" : "none";
        }
        <form asp-action="Delete" asp-route-id="@firsat.FirsatId" method="post" style="display:inline;" onsubmit="return confirm('Bu fırsatı silmek istediğinize emin misiniz?');">
            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
        </form>
    }
</script>