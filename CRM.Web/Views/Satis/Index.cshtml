@model List<CRM.DTO.SatisDto>

@{
    ViewData["Title"] = "Satışlar";
}

<h2>Satış Listesi</h2>
<input type="text" id="aramaKutusuSatis" class="form-control mb-3" placeholder="Ödeme durumu ile ara..." onkeyup="tabloyuFiltreleSatis()" style="max-width: 400px;" />
<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Satış</a>

<table class="table table-striped" id="satisTablosu">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Toplam Tutar</th>
            <th>Ödeme Durumu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var satis in Model)
        {
            <tr>
                <td>@satis.SatisTarihi.ToString("dd.MM.yyyy")</td>
                <td>@satis.ToplamTutar</td>
                <td>@satis.OdemeDurumu</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@satis.SatisId" class="btn btn-sm btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function tabloyuFiltreleSatis() {
        var arananMetin = document.getElementById("aramaKutusuSatis").value.toLowerCase();
        var tablo = document.getElementById("satisTablosu");
        var satirlar = tablo.getElementsByTagName("tr");

        for (var i = 1; i < satirlar.length; i++) {
            var satir = satirlar[i];
            var satirMetni = satir.textContent.toLowerCase();
            satir.style.display = satirMetni.indexOf(arananMetin) > -1 ? "" : "none";
        }
        <form asp-action="Delete" asp-route-id="@satis.SatisId" method="post" style="display:inline;" onsubmit="return confirm('Bu satışı silmek istediğinize emin misiniz?');">
            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
        </form>
    }
</script>