@model List<CRM.DTO.UrunDto>

@{
    ViewData["Title"] = "Ürünler";
}

<h2>Ürün Listesi</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Ürün</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ürün Adı</th>
            <th>Birim Fiyat</th>
            <th>KDV Oranı</th>
            <th>Aktif Mi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var urun in Model)
        {
            <tr>
                <td>@urun.UrunAdi</td>
                <td>@urun.BirimFiyat</td>
                <td>@urun.KdvOrani</td>
                <td>@(urun.AktifMi ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@urun.UrunId" class="btn btn-sm btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>