@model List<CRM.DTO.UrunDto>

@{
    ViewData["Title"] = "Ürünler";
}

<h2>Ürün Listesi</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Ürün</a>

<table class="table table-striped" id="urunTablosu">
    <thead>
        <tr>
            <th>Ürün Adı</th>
            <th>Birim Fiyat</th>
            <th>KDV Oranı</th>
            <th>Aktif Mi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var urun in Model)
        {
            <tr>
                <td>@urun.UrunAdi</td>
                <td>@urun.BirimFiyat</td>
                <td>@urun.KdvOrani</td>
                <td>@(urun.AktifMi ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@urun.UrunId" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@urun.UrunId" method="post" style="display:inline;" onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function tabloyuFiltreleUrun() {
        var arananMetin = document.getElementById("aramaKutusuUrun").value.toLowerCase();
        var tablo = document.getElementById("urunTablosu");
        var satirlar = tablo.getElementsByTagName("tr");

        for (var i = 1; i < satirlar.length; i++) {
            var satir = satirlar[i];
            var satirMetni = satir.textContent.toLowerCase();
            satir.style.display = satirMetni.indexOf(arananMetin) > -1 ? "" : "none";
        }
    }
</script>
