@model List<CRM.DTO.AktiviteDto>

@{
    ViewData["Title"] = "Aktiviteler";
}

<h2>Aktivite Listesi</h2>
<input type="text" id="aramaKutusuAktivite" class="form-control mb-3" placeholder="Konu veya tip ile ara..." onkeyup="tabloyuFiltreleAktivite()" style="max-width: 400px;" />
<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Aktivite</a>

<table class="table table-striped" id="aktiviteTablosu">
    <thead>
        <tr>
            <th>Konu</th>
            <th>Tip</th>
            <th>Durum</th>
            <th>Tarih</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var aktivite in Model)
        {
            <tr>
                <td>@aktivite.Konu</td>
                <td>@aktivite.AktiviteTipi</td>
                <td>@aktivite.AktiviteDurumu</td>
                <td>@aktivite.AktiviteTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@aktivite.AktiviteId" class="btn btn-sm btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function tabloyuFiltreleAktivite() {
        var arananMetin = document.getElementById("aramaKutusuAktivite").value.toLowerCase();
        var tablo = document.getElementById("aktiviteTablosu");
        var satirlar = tablo.getElementsByTagName("tr");

        for (var i = 1; i < satirlar.length; i++) {
            var satir = satirlar[i];
            var satirMetni = satir.textContent.toLowerCase();
            satir.style.display = satirMetni.indexOf(arananMetin) > -1 ? "" : "none";
        }
        <form asp-action="Delete" asp-route-id="@aktivite.AktiviteId" method="post" style="display:inline;" onsubmit="return confirm('Bu aktiviteyi silmek istediğinize emin misiniz?');">
            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
        </form>
    }
</script>