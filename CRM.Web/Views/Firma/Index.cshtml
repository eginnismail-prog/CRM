@model List<CRM.DTO.FirmaDto>

@{
    ViewData["Title"] = "Firmalar";
}

<h2>Firma Listesi</h2>
<input type="text" id="aramaKutusuFirma" class="form-control mb-3" placeholder="Firma adı veya şehir ile ara..." onkeyup="tabloyuFiltreleFirma()" style="max-width: 400px;" />
<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Firma</a>

<table class="table table-striped" id="firmaTablosu">
    <thead>
        <tr>
            <th>Firma Adı</th>
            <th>Vergi No</th>
            <th>Telefon</th>
            <th>Şehir</th>
            <th>Aktif Mi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var firma in Model)
        {
            <tr>
                <td>@firma.FirmaAdi</td>
                <td>@firma.VergiNo</td>
                <td>@firma.Telefon</td>
                <td>@firma.Sehir</td>
                <td>@(firma.AktifMi ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@firma.FirmaId" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@firma.FirmaId" method="post" style="display:inline;" onsubmit="return confirm('Bu firmayı silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function tabloyuFiltreleFirma() {
        var arananMetin = document.getElementById("aramaKutusuFirma").value.toLowerCase();
        var tablo = document.getElementById("firmaTablosu");
        var satirlar = tablo.getElementsByTagName("tr");

        for (var i = 1; i < satirlar.length; i++) {
            var satir = satirlar[i];
            var satirMetni = satir.textContent.toLowerCase();
            satir.style.display = satirMetni.indexOf(arananMetin) > -1 ? "" : "none";
        }
    }
</script>