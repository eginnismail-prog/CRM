@model List<CRM.DTO.FirmaDto>

@{
    ViewData["Title"] = "Firmalar";
}

<h2>Firma Listesi</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Firma</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Firma Adı</th>
            <th>Vergi No</th>
            <th>Telefon</th>
            <th>Şehir</th>
            <th>Aktif Mi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var firma in Model)
        {
            <tr>
                <td>@firma.FirmaAdi</td>
                <td>@firma.VergiNo</td>
                <td>@firma.Telefon</td>
                <td>@firma.Sehir</td>
                <td>@(firma.AktifMi ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@firma.FirmaId" class="btn btn-sm btn-warning">Düzenle</a>
                </td>
            </tr>
        }
    </tbody>
</table>