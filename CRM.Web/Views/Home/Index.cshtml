@model CRM.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2> SURYAPI </h2>

<p class="content-subtitle">Müşteri ve satış yönetim sistemi</p>
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card card-suryapi-1 mb-3">
            <div class="card-body">
                <h5 class="card-title">Toplam Müşteri</h5>
                <p class="card-text fs-2">@Model.ToplamMusteriSayisi</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-suryapi-2 mb-3">
            <div class="card-body">
                <h5 class="card-title">Toplam Fırsat</h5>
                <p class="card-text fs-2">@Model.ToplamFirsatSayisi</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-suryapi-3 mb-3">
            <div class="card-body">
                <h5 class="card-title">Toplam Satış</h5>
                <p class="card-text fs-2">@Model.ToplamSatisSayisi</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-suryapi-4 mb-3">
            <div class="card-body">
                <h5 class="card-title">Toplam Satış Tutarı</h5>
                <p class="card-text fs-2">@Model.ToplamSatisTutari.ToString("N2") ₺</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Musteri" asp-action="Index" class="btn btn-outline-primary">Müşterileri Görüntüle</a>
    <a asp-controller="Firsat" asp-action="Index" class="btn btn-outline-primary">Fırsatları Görüntüle</a>
    <a asp-controller="Satis" asp-action="Index" class="btn btn-outline-primary">Satışları Görüntüle</a>
</div>
