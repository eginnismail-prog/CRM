<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - CRM.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CRM.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-suryapi">
        <div class="sidebar-brand"> SURYAPI </div>
        <ul class="sidebar-nav">
            <li><a asp-controller="Home" asp-action="Index">Genel Bakış</a></li>
            <li><a asp-controller="Musteri" asp-action="Index">Müşteriler</a></li>
            <li><a asp-controller="Firma" asp-action="Index">Firmalar</a></li>
            <li><a asp-controller="Urun" asp-action="Index">Ürünler</a></li>
            <li><a asp-controller="Firsat" asp-action="Index">Fırsatlar</a></li>
            <li><a asp-controller="Aktivite" asp-action="Index">Aktiviteler</a></li>
            <li><a asp-controller="Teklif" asp-action="Index">Teklifler</a></li>
            <li><a asp-controller="Satis" asp-action="Index">Satışlar</a></li>
        </ul>
    </div>

    <div class="content-suryapi">
        <main role="main">
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted mt-4 pt-3">
            &copy; 2026 - Süryapı CRM - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>